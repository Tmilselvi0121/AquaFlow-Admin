# ====================================================================
# AquaFlow Water Purifier E-Commerce — Environment Configuration
# ====================================================================

# --- 1. Backend Server & API ---
PORT=5000
API_BASE_URL="http://localhost:5000"

# --- 1b. Admin Portal Credentials (set these before production use) ---
# Used by backend/server.js for /api/admin/login and admin-only routes
ADMIN_EMAIL="admin@aquaflow.com"
ADMIN_PASSWORD="change-this-strong-password"
ADMIN_SECRET_TOKEN="change-this-long-random-token"

# --- 2. Firebase Cloud Firestore (Spark Plan) ---
# Service Account Key is located at: backend/serviceAccountKey.json
# Project ID: aquaflow-547ef
FIREBASE_PROJECT_ID="aquaflow-547ef"

# --- 3. Razorpay Payment Gateway (Test Mode) ---
# Sign up free at https://dashboard.razorpay.com and toggle 'Test Mode'
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="your_razorpay_test_secret"

# --- 4. OpenStreetMap ---
# OpenStreetMap & Nominatim are 100% free with zero API key requirement!
# Public endpoint: https://nominatim.openstreetmap.org

# --- 5. Email Notifications (EmailJS Free Tier) ---
# Sign up free at https://www.emailjs.com
EMAILJS_SERVICE_ID="service_aquaflow"
EMAILJS_TEMPLATE_ID="template_order_confirm"
EMAILJS_PUBLIC_KEY="your_emailjs_public_key"

# --- 6. SMS Notifications (TextBee Free Tier) ---
# Sign up free at https://textbee.dev
TEXTBEE_API_KEY="your_textbee_api_key"
TEXTBEE_DEVICE_ID="your_textbee_device_id"

# --- 7. AI Caption Generation (Gemini or Groq Free Tier) ---
# Google Gemini: Get free key at https://aistudio.google.com
GEMINI_API_KEY="AIzaSy..."
# Or Groq Cloud: Get free key at https://console.groq.com
GROQ_API_KEY="gsk_..."

# --- 8. Public Image Hosting (ImgBB Free Tier) ---
# Get free key at https://api.imgbb.com
IMGBB_API_KEY="your_imgbb_api_key"

# --- 9. Meta / Instagram Graph API (Automated Daily Posting) ---
# Setup at https://developers.facebook.com with Instagram Graph API
# Requires an Instagram Professional / Business account connected to a Facebook page
META_ACCESS_TOKEN="EAA..."
INSTAGRAM_ACCOUNT_ID="17841400000000000"
